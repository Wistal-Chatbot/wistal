<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!--
  Wistal ERP — Outlook task pane (add-in-only XML manifest).

  Broadest compatibility across Outlook Web + Desktop (classic and new Windows,
  Mac). SourceLocation points at the /outlook segment of the Next.js app; the
  same origin serves the API, so there is no CORS. Requirement set Mailbox 1.5
  enables ItemChanged + task-pane pinning (SupportsPinning) so the context banner
  refreshes when the pinned pane switches messages.

  Dev: run the app over HTTPS on localhost:3000 (office-addin-dev-certs) and
  sideload this file. For production, replace https://localhost:3000 with the
  deployed origin (e.g. https://<app>.vercel.app).
-->
<OfficeApp
  xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
  xmlns:mailappor="http://schemas.microsoft.com/office/mailappversionoverrides/1.0"
  xsi:type="MailApp">
  <Id>0ddc0849-5d86-476a-9b44-c4b0bd11d29b</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>Wistal</ProviderName>
  <DefaultLocale>pl-PL</DefaultLocale>
  <DisplayName DefaultValue="Wistal ERP — Asystent"/>
  <Description DefaultValue="Zapytaj asystenta ERP Wistal o dane (historia zamówień, salda faktur, stany magazynowe) bez opuszczania Outlooka."/>
  <IconUrl DefaultValue="https://localhost:3000/outlook/assets/icon-64.png"/>
  <HighResolutionIconUrl DefaultValue="https://localhost:3000/outlook/assets/icon-128.png"/>
  <SupportUrl DefaultValue="https://localhost:3000/outlook"/>
  <AppDomains>
    <AppDomain>localhost</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Mailbox"/>
  </Hosts>
  <Requirements>
    <Sets>
      <Set Name="Mailbox" MinVersion="1.5"/>
    </Sets>
  </Requirements>
  <FormSettings>
    <Form xsi:type="ItemRead">
      <DesktopSettings>
        <SourceLocation DefaultValue="https://localhost:3000/outlook"/>
        <RequestedHeight>450</RequestedHeight>
      </DesktopSettings>
    </Form>
  </FormSettings>
  <Permissions>ReadItem</Permissions>
  <Rule xsi:type="RuleCollection" Mode="Or">
    <Rule xsi:type="ItemIs" ItemType="Message" FormType="Read"/>
  </Rule>
  <DisableEntityHighlighting>false</DisableEntityHighlighting>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/mailappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Requirements>
      <bt:Sets DefaultMinVersion="1.5">
        <bt:Set Name="Mailbox"/>
      </bt:Sets>
    </Requirements>
    <Hosts>
      <Host xsi:type="MailHost">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="MessageReadCommandSurface">
            <OfficeTab id="TabDefault">
              <Group id="wistalMsgReadGroup">
                <Label resid="GroupLabel"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16x16"/>
                  <bt:Image size="32" resid="Icon.32x32"/>
                  <bt:Image size="80" resid="Icon.80x80"/>
                </Icon>
                <Control xsi:type="Button" id="wistalOpenPaneButton">
                  <Label resid="TaskpaneButton.Label"/>
                  <Supertip>
                    <Title resid="TaskpaneButton.Label"/>
                    <Description resid="TaskpaneButton.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16x16"/>
                    <bt:Image size="32" resid="Icon.32x32"/>
                    <bt:Image size="80" resid="Icon.80x80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <SupportsPinning>true</SupportsPinning>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16x16" DefaultValue="https://localhost:3000/outlook/assets/icon-16.png"/>
        <bt:Image id="Icon.32x32" DefaultValue="https://localhost:3000/outlook/assets/icon-32.png"/>
        <bt:Image id="Icon.80x80" DefaultValue="https://localhost:3000/outlook/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://localhost:3000/outlook"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://localhost:3000/outlook"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="GroupLabel" DefaultValue="Wistal ERP"/>
        <bt:String id="TaskpaneButton.Label" DefaultValue="Asystent ERP"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="TaskpaneButton.Tooltip" DefaultValue="Otwórz panel asystenta ERP Wistal dla bieżącej wiadomości."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
